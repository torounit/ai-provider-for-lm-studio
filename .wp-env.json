{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"testsEnvironment": false,
	"autoPort": true,
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/ai.zip"
	],
	"config": {
		"WP_DEVELOPMENT_MODE": "plugin",
		"WP_ENVIRONMENT_TYPE": "development",
		"WP_DEBUG": true,
		"LM_STUDIO_BASE_URL": "http://host.docker.internal:1234/v1",
		"WP_DEBUG_LOG": "/var/www/html/wp-content/plugins/ai-provider-for-lm-studio/debug.log"
	},
	"phpVersion": "8.4",
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp rewrite structure /%postname%/ --hard"
	}
}
